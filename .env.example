# Use only a NEW, independent Supabase project. These are placeholders, never secrets.
# Browser values are public. Never use service_role or sb_secret_ keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional MCP server only. May use the same PUBLIC project key.
# Ordinary email/password training does not require MCP or OAuth client setup.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
